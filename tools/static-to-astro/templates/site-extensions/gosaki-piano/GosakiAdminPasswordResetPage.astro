---
import "../styles/gosaki-staging-read-only-admin.css";
import "../styles/gosaki-admin-shell-chrome.css";
import { GOSAKI_STAGING_ADMIN_BASE } from "../lib/gosaki-package-admin-paths";
import {
  isG11c4aSupabaseAuthConfigured,
  resolveG11c4aSupabaseAnonKey,
  resolveG11c4aSupabaseUrl,
  resolveGosakiAdminFooterText,
} from "../lib/gosaki-staging-read-only-admin";
import { GOSAKI_PRODUCTION_PASSWORD_RESET_REDIRECT } from "../lib/gosaki-admin-password-reset.mjs";

interface Props {
  mode?: "forgot" | "reset";
}

const { mode = "forgot" } = Astro.props as Props;
const isForgot = mode === "forgot";
const configured = isG11c4aSupabaseAuthConfigured(import.meta.env);
const supabaseUrl = configured ? resolveG11c4aSupabaseUrl(import.meta.env) : "";
const supabaseAnonKey = configured ? resolveG11c4aSupabaseAnonKey(import.meta.env) : "";
const adminHome = GOSAKI_STAGING_ADMIN_BASE;
const forgotHref = `${adminHome}forgot-password/`;
const title = isForgot ? "パスワード再設定メール" : "新しいパスワード";
const footer = resolveGosakiAdminFooterText(import.meta.env);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>{title} | Gosaki Piano CMS</title>
  </head>
  <body class="gosaki-read-only-admin" data-gosaki-read-only-admin="true">
    <div class="gosaki-read-only-admin__shell">
      <header class="gosaki-read-only-admin__header">
        <a class="gosaki-read-only-admin__brand" href={adminHome}>Gosaki Piano CMS</a>
      </header>
      <main class="gosaki-read-only-admin__main">
        <div
          class="gosaki-admin-password-reset"
          data-gosaki-password-reset={mode}
          data-gosaki-supabase-auth-configured={configured ? "true" : "false"}
          data-gosaki-supabase-url={supabaseUrl}
          data-gosaki-supabase-anon-key={supabaseAnonKey}
          data-gosaki-password-reset-redirect={GOSAKI_PRODUCTION_PASSWORD_RESET_REDIRECT}
          data-gosaki-admin-home={adminHome}
          data-gosaki-forgot-href={forgotHref}
        >
          <section class="gosaki-admin-password-reset__card" aria-labelledby="gosaki-password-reset-title">
            <p class="gosaki-admin-password-reset__back">
              <a href={adminHome}>← ログインに戻る</a>
            </p>
            <h1 id="gosaki-password-reset-title">{title}</h1>
            {
              isForgot ? (
                <p class="gosaki-read-only-admin__meta">
                  登録しているメールアドレスを入力してください。登録がある場合だけ、再設定用のメールが届きます。
                </p>
              ) : (
                <p class="gosaki-read-only-admin__meta" id="gosaki-password-reset-lead">
                  メールのリンクから開いた場合だけ、新しいパスワードを設定できます。
                </p>
              )
            }
            {
              !configured ? (
                <p class="gosaki-read-only-admin__meta gosaki-read-only-admin__meta--warn" role="status">
                  ログイン設定が未完了です。管理者にお問い合わせください。
                </p>
              ) : null
            }
            <form id="gosaki-password-forgot-form" class="gosaki-read-only-admin__auth-form" hidden={!isForgot || !configured}>
              <div class="gosaki-read-only-admin__field">
                <label for="gosaki-password-forgot-email">メールアドレス</label>
                <input id="gosaki-password-forgot-email" type="email" autocomplete="username" inputmode="email" spellcheck="false" />
              </div>
              <div class="gosaki-read-only-admin__auth-actions">
                <button id="gosaki-password-forgot-submit" class="gosaki-read-only-admin__btn gosaki-read-only-admin__btn--primary" type="submit">
                  再設定メールを送る
                </button>
              </div>
            </form>
            <form id="gosaki-password-update-form" class="gosaki-read-only-admin__auth-form" hidden>
              <div class="gosaki-read-only-admin__field">
                <label for="gosaki-password-new">新しいパスワード</label>
                <input id="gosaki-password-new" type="password" autocomplete="new-password" />
              </div>
              <div class="gosaki-read-only-admin__field">
                <label for="gosaki-password-confirm">新しいパスワード（確認）</label>
                <input id="gosaki-password-confirm" type="password" autocomplete="new-password" />
              </div>
              <div class="gosaki-read-only-admin__auth-actions">
                <button id="gosaki-password-update-submit" class="gosaki-read-only-admin__btn gosaki-read-only-admin__btn--primary" type="submit">
                  パスワードを保存
                </button>
              </div>
            </form>
            <p id="gosaki-password-reset-success" class="gosaki-read-only-admin__meta gosaki-read-only-admin__meta--ok" hidden role="status"></p>
            <p id="gosaki-password-reset-error" class="gosaki-read-only-admin__meta gosaki-read-only-admin__meta--warn" hidden role="alert"></p>
            <p id="gosaki-password-reset-invalid" class="gosaki-admin-password-reset__invalid" hidden>
              このリンクは無効か、期限切れです。パスワード再設定をやり直してください。
              <a href={forgotHref}>再設定メールを送り直す</a>
            </p>
          </section>
        </div>
      </main>
      <footer class="gosaki-read-only-admin__footer">{footer}</footer>
    </div>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.49.1/dist/umd/supabase.js"></script>
    <script>
      import {
        classifyResetEmailFailure,
        formatPasswordUpdateError,
        parseRecoveryHash,
        recoveryInitStatusMessage,
        resetEmailStatusMessage,
        resolveRecoveryUiState,
        GOSAKI_PASSWORD_MIN_LENGTH,
      } from "../lib/gosaki-admin-password-reset.mjs";

      function startGosakiPasswordReset() {
      const root = document.querySelector("[data-gosaki-password-reset]");
      if (!(root instanceof HTMLElement)) return;
        const mode = root.dataset.gosakiPasswordReset || "";
        const configured = root.dataset.gosakiSupabaseAuthConfigured === "true";
        const redirectTo = root.dataset.gosakiPasswordResetRedirect || "";
        const requestedHome = root.dataset.gosakiAdminHome || "/admin/";
        const adminHome =
          requestedHome.startsWith("/") && !requestedHome.startsWith("//") ? requestedHome : "/admin/";
        const forgotForm = document.getElementById("gosaki-password-forgot-form");
        const updateForm = document.getElementById("gosaki-password-update-form");
        const successEl = document.getElementById("gosaki-password-reset-success");
        const errorEl = document.getElementById("gosaki-password-reset-error");
        const invalidEl = document.getElementById("gosaki-password-reset-invalid");

        const show = (el: HTMLElement | null, message?: string) => {
          if (!el) return;
          if (message) el.textContent = message;
          el.hidden = false;
        };
        const hide = (el: HTMLElement | null) => {
          if (!el) return;
          el.hidden = true;
        };
        const clearAuthFromAddress = () => {
          const path = window.location.pathname;
          window.history.replaceState(null, "", path);
        };
        const resolveCreateClient = () => {
          const lib = (window as Window & { supabase?: { createClient?: Function; default?: { createClient?: Function } } }).supabase;
          if (!lib) return null;
          if (typeof lib.createClient === "function") return lib.createClient;
          if (lib.default && typeof lib.default.createClient === "function") return lib.default.createClient;
          return null;
        };
        const waitForCreateClient = () =>
          new Promise((resolve) => {
            let left = 40;
            const tick = () => {
              const createClient = resolveCreateClient();
              if (createClient) {
                resolve(createClient);
                return;
              }
              left -= 1;
              if (left <= 0) {
                resolve(null);
                return;
              }
              window.setTimeout(tick, 100);
            };
            tick();
          });

        if (mode === "forgot" && configured && forgotForm) {
          forgotForm.addEventListener("submit", (event) => {
            event.preventDefault();
            const emailInput = document.getElementById("gosaki-password-forgot-email");
            const submit = document.getElementById("gosaki-password-forgot-submit");
            const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : "";
            hide(successEl);
            hide(errorEl);
            if (!email) {
              show(errorEl, "メールアドレスを入力してください。");
              return;
            }
            void (async () => {
              if (submit instanceof HTMLButtonElement) submit.disabled = true;
              try {
                const createClient = await waitForCreateClient();
                if (!createClient || !redirectTo.startsWith("https://www.gosaki-piano.com/admin/reset-password")) {
                  show(errorEl, resetEmailStatusMessage("generic_failure"));
                  return;
                }
                const client = createClient(root.dataset.gosakiSupabaseUrl, root.dataset.gosakiSupabaseAnonKey, {
                  auth: {
                    flowType: "implicit",
                    persistSession: false,
                    autoRefreshToken: false,
                    detectSessionInUrl: false,
                  },
                });
                let failure: { status?: number; message?: string; name?: string } | null = null;
                try {
                  const result = await client.auth.resetPasswordForEmail(email, { redirectTo });
                  failure = result.error;
                } catch (err) {
                  failure = {
                    name: err instanceof Error ? err.name : "Error",
                    message: err instanceof Error ? err.message : "failed to fetch",
                  };
                }
                const kind = classifyResetEmailFailure(failure);
                if (kind === "rate_limit" || kind === "network" || kind === "generic_failure") {
                  show(errorEl, resetEmailStatusMessage(kind));
                  return;
                }
                if (emailInput instanceof HTMLInputElement) emailInput.value = "";
                hide(forgotForm);
                show(successEl, resetEmailStatusMessage("generic_success"));
              } finally {
                if (submit instanceof HTMLButtonElement) submit.disabled = false;
              }
            })();
          });
        }

        if (mode === "reset") {
          hide(forgotForm);
          const parsed = parseRecoveryHash(window.location.hash);
          if (!parsed.acceptable) {
            clearAuthFromAddress();
            hide(updateForm);
            hide(document.getElementById("gosaki-password-reset-lead"));
            show(invalidEl);
            return;
          }
          if (!configured) {
            clearAuthFromAddress();
            hide(updateForm);
            hide(document.getElementById("gosaki-password-reset-lead"));
            return;
          }

          void (async () => {
            const createClient = await waitForCreateClient();
            if (!createClient) {
              clearAuthFromAddress();
              show(invalidEl);
              return;
            }
            const client = createClient(root.dataset.gosakiSupabaseUrl, root.dataset.gosakiSupabaseAnonKey, {
              auth: {
                flowType: "implicit",
                persistSession: true,
                autoRefreshToken: true,
                detectSessionInUrl: true,
              },
            });
            let recoveryReady = false;
            let settled = false;
            let recoveryEvent = "";
            let subscription = { unsubscribe() {} };
            const authListener = client.auth.onAuthStateChange((event: string) => {
              if (event !== "PASSWORD_RECOVERY" || settled) return;
              recoveryEvent = event;
              recoveryReady = true;
              settled = true;
              clearAuthFromAddress();
              show(updateForm);
              const recoveryLead = document.getElementById("gosaki-password-reset-lead");
              if (recoveryLead) recoveryLead.textContent = "新しいパスワードを入力して保存してください。";
              window.setTimeout(() => subscription.unsubscribe(), 0);
            });
            subscription = authListener?.data?.subscription || subscription;
            updateForm?.addEventListener("submit", (event) => {
              event.preventDefault();
              if (!recoveryReady) return;
              const nextInput = document.getElementById("gosaki-password-new");
              const confirmInput = document.getElementById("gosaki-password-confirm");
              const submit = document.getElementById("gosaki-password-update-submit");
              const password = nextInput instanceof HTMLInputElement ? nextInput.value : "";
              const confirm = confirmInput instanceof HTMLInputElement ? confirmInput.value : "";
              hide(errorEl);
              if (!password || !confirm) {
                show(errorEl, "新しいパスワードを入力してください。");
                return;
              }
              if (password.length < GOSAKI_PASSWORD_MIN_LENGTH) {
                show(errorEl, `パスワードは${GOSAKI_PASSWORD_MIN_LENGTH}文字以上で入力してください。`);
                return;
              }
              if (password !== confirm) {
                show(errorEl, "パスワードが一致しません。");
                return;
              }
              void (async () => {
                if (submit instanceof HTMLButtonElement) submit.disabled = true;
                const { error } = await client.auth.updateUser({ password });
                if (nextInput instanceof HTMLInputElement) nextInput.value = "";
                if (confirmInput instanceof HTMLInputElement) confirmInput.value = "";
                if (error) {
                  const text = formatPasswordUpdateError(error.message);
                  if (text.startsWith("リンクが無効")) {
                    hide(updateForm);
                    show(invalidEl);
                    void client.auth.signOut({ scope: "local" });
                  } else {
                    show(errorEl, text);
                  }
                  if (submit instanceof HTMLButtonElement) submit.disabled = false;
                  return;
                }
                await client.auth.signOut({ scope: "local" });
                window.location.replace(`${adminHome}?reset=success`);
              })();
            });
            const lead = document.getElementById("gosaki-password-reset-lead");
            if (lead) lead.textContent = "確認しています…";
            let initError: { status?: number; message?: string; name?: string } | null = null;
            try {
              const initResult = await client.auth.initialize();
              initError = initResult?.error ?? null;
            } catch (err) {
              initError = {
                name: err instanceof Error ? err.name : "Error",
                message: err instanceof Error ? err.message : "failed to fetch",
              };
            }
            // PASSWORD_RECOVERY is queued after initialize() resolves. Wait for that turn.
            // Do not treat a slow Auth response as an invalid link, and do not sign out here.
            await new Promise((resolve) => window.setTimeout(resolve, 0));
            const ui = resolveRecoveryUiState({
              recoveryEvent,
              initSettled: true,
              initError,
            });
            if (ui === "form" || settled) return;
            settled = true;
            subscription.unsubscribe();
            hide(updateForm);
            hide(lead);
            if (ui === "invalid") {
              clearAuthFromAddress();
              show(invalidEl);
              return;
            }
            show(errorEl, recoveryInitStatusMessage(ui === "network" ? "network" : "unknown"));
          })();
        }
      }
      startGosakiPasswordReset();
    </script>
  </body>
</html>
