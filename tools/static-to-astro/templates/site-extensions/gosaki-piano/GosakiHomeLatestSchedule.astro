---
import schedules from "../data/gosaki-schedules.json";
import { withBase } from "../lib/with-base.ts";
import {
  gosakiHomeScheduleDateParts,
  gosakiHomeScheduleItemPath,
  gosakiHomeScheduleTitle,
  selectGosakiHomeLatestSchedules,
} from "../lib/gosaki-home-latest-schedule.ts";

const events = selectGosakiHomeLatestSchedules(schedules);
const scheduleHref = withBase("/schedule/");
---

<section class="gosaki-home-schedule" aria-labelledby="gosaki-home-schedule-heading">
  <div class="gosaki-home-schedule__inner">
    <h2 id="gosaki-home-schedule-heading" class="gosaki-home-schedule__title">Schedule</h2>
    {
      events.length > 0 ? (
        <ul class="gosaki-home-schedule__list">
          {events.map((ev) => {
            const title = gosakiHomeScheduleTitle(ev.title);
            const dateParts = gosakiHomeScheduleDateParts(ev);
            const venue = String(ev.venue || "").trim();
            const itemPath = gosakiHomeScheduleItemPath(ev);
            const itemHref = itemPath ? withBase(itemPath) : null;
            const body = (
              <>
                {dateParts ? (
                  <span class="gosaki-home-schedule__badge">
                    <span class="gosaki-home-schedule__badge-year">{dateParts.year}</span>
                    <span class="gosaki-home-schedule__badge-day">{dateParts.monthDay}</span>
                    <span class="gosaki-home-schedule__badge-week">{dateParts.weekday}</span>
                  </span>
                ) : null}
                <span class="gosaki-home-schedule__copy">
                  {title ? <p class="gosaki-home-schedule__name">{title}</p> : null}
                  {venue ? <p class="gosaki-home-schedule__venue">{venue}</p> : null}
                </span>
              </>
            );
            return (
              <li class="gosaki-home-schedule__item">
                {itemHref ? (
                  <a class="gosaki-home-schedule__card gosaki-home-schedule__link" href={itemHref}>
                    {body}
                  </a>
                ) : (
                  <div class="gosaki-home-schedule__card">{body}</div>
                )}
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="gosaki-home-schedule__empty">公開中のスケジュールは Schedule ページをご覧ください。</p>
      )
    }
    <p class="gosaki-home-schedule__more">
      <a href={scheduleHref}>Scheduleを見る</a>
    </p>
  </div>
</section>
