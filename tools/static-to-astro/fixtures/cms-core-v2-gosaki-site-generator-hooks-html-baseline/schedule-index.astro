  lang="ja"
>
  <section class="gosaki-schedule-hub">
    <h1 class="gosaki-schedule-hub__title">Schedule</h1>
    <div class="gosaki-schedule-months">
      <!-- CMS_TARGET: SCHEDULE_INDEX scheduleDataSource=supabase -->
      <a href={withBase('/schedule/2026-08/')} class="gosaki-schedule-month-link">2026.08</a>
    </div>
  </section>
</BaseLayout>
